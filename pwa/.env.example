# CartWise PWA — environment configuration
#
# Phase 3 cloud backend (Supabase). When these are set, the app is intended to
# use Supabase Auth + Postgres instead of the local-only auth/store. Without
# them, CartWise runs fully locally (guest + local accounts in this browser).
#
# Copy this file to `.env.local` and fill in your project values. Never commit
# real keys. The anon key is a public client key (safe for the browser), but
# still keep it out of version control.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PayPal Subscriptions (premium). Public values — safe in the client.
# The secret + webhook id live in the Supabase Edge Function secrets, not here.
# See docs/PAYMENTS.md.
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_PLAN_ID=
